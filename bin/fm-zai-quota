#!/usr/bin/env bash
# fm-zai-quota - visibility for every z.ai key (Team-Coding-Plan seats + the
# prepaid token pack), quota-axi-style one line per key. Read by fm-usage-bericht
# and the Tagesschluss; closes the zai-pack-verbrauchsanzeige blind spot as far
# as the provider allows.
#
# Output (one line per key):
#   <sitz>  <env-name>  <stand>
# where <stand> is the monitor API's usable numbers, or the provider's error
# verbatim (shortened) - an honest "unlesbar: ..." beats an invented zero.
# Exit 0 always (a reporting tool never blocks a pipeline); exit 2 only when
# the key file itself is unreadable.
#
# Monitor API: GET https://api.z.ai/api/monitor/usage/quota/limit with
# Authorization: <key> (no Bearer). As of 26.08.2026 it answers "当前用户不存在
# coding plan" for the captain's seats although inference runs; this tool prints
# that answer so the day the endpoint starts working is visible in the reports.
#
# Env overrides (tests): FM_ZAI_ENV, FM_ZAI_CURL.

set -u

ENV_FILE="${FM_ZAI_ENV:-$HOME/.config/claw/env}"
CURL_BIN="${FM_ZAI_CURL:-curl}"
# type=2 = Team-Plan-Abruf; type=1/ohne antwortet fuer Team-Keys "kein coding
# plan" (gemessen 26.08.). data.limits[] fuellt der Provider verzoegert.
MONITOR_URL="https://api.z.ai/api/monitor/usage/quota/limit?type=2"

# Team-Scope (O-0114-Nachtrag 26.08.): der Team-Monitor ist organisations- und
# projekt-gescoped. Ohne diese Header antwortet er "success" mit LEEREM data -
# das war die wochenlange Leere. Die IDs stehen in der eingeloggten Konsole
# (localStorage Bigmodel-Organization / Bigmodel-Project) und kommen aus
# ~/.config/claw/env als ZAI_TEAM_ORG_ID / ZAI_TEAM_PROJECT_ID. Ohne die
# Variablen laufen die Abfragen unveraendert (Header weglassen, nie leer senden).
scope_args_bauen() { # liest die IDs aus Umgebung ODER der Env-Datei (sed wie die Keys)
  SCOPE_ARGS=()
  local org="${ZAI_TEAM_ORG_ID:-}" proj="${ZAI_TEAM_PROJECT_ID:-}"
  [ -z "$org" ] && [ -r "$ENV_FILE" ] && org=$(sed -n 's/^ZAI_TEAM_ORG_ID=//p' "$ENV_FILE" | head -n 1)
  [ -z "$proj" ] && [ -r "$ENV_FILE" ] && proj=$(sed -n 's/^ZAI_TEAM_PROJECT_ID=//p' "$ENV_FILE" | head -n 1)
  [ -n "$org" ] && SCOPE_ARGS+=(-H "bigmodel-organization: $org")
  [ -n "$proj" ] && SCOPE_ARGS+=(-H "bigmodel-project: $proj")
}
scope_args_bauen

[ -r "$ENV_FILE" ] || { printf 'fm-zai-quota: key file %s unreadable\n' "$ENV_FILE" >&2; exit 2; }

# --mitglieder: Verbrauch je Team-Mitglied (Monitor sub-account-rank, letzte 7
# Tage): Name, 5h-/Wochen-Prozent, Gesamt-Tokens, Modell-Aufschluesselung.
# Braucht die Team-Scope-Header wie die Quota-Abfrage.
if [ "${1:-}" = "--mitglieder" ]; then
  scope_args_bauen
  key=$(sed -n 's/^ZAI_TEAM_KEY_1=//p' "$ENV_FILE" | head -n 1)
  [ -n "$key" ] || { echo "fm-zai-quota: ZAI_TEAM_KEY_1 fehlt" >&2; exit 2; }
  von=$(date -d '7 days ago' '+%Y-%m-%d %H:%M:%S'); bis=$(date '+%Y-%m-%d %H:%M:%S')
  "$CURL_BIN" -sSG -m 10 -H "Authorization: $key" -H "Accept-Language: en-US,en" \
    ${SCOPE_ARGS[@]+"${SCOPE_ARGS[@]}"} \
    --data-urlencode "startTime=$von" --data-urlencode "endTime=$bis" \
    "https://api.z.ai/api/monitor/usage/sub-account-rank" | python3 -c '
import json, sys
try:
    d = json.load(sys.stdin)
except Exception:
    print("unlesbar: keine JSON-Antwort"); raise SystemExit(1)
if not d.get("success"):
    print("unlesbar: " + str(d.get("msg"))[:120]); raise SystemExit(1)
def punkt(n):
    return f"{n:,}".replace(",", ".")
for m in (d.get("data") or {}).get("rankList") or []:
    r = m.get("rateLimitStatus") or {}
    modelle = ", ".join(x.get("modelName", "?") + " " + punkt(x.get("tokens", 0))
                        for x in (m.get("modelTokenDetails") or [])[:4])
    felder = [str(m.get("memberName")),
              "5h " + str(r.get("fiveHourPercentage")) + "%",
              "Woche " + str(r.get("weekPercentage")) + "%",
              punkt(m.get("totalTokens", 0)) + " Tokens (7 Tage)",
              modelle]
    print("\t".join(felder))
'
  exit $?
fi

zeile() { # <sitz> <env-name>
  local sitz=$1 name=$2 key antwort stand
  key=$(sed -n "s/^$name=//p" "$ENV_FILE" | head -n 1)
  if [ -z "$key" ]; then
    printf '%s\t%s\tkein Key hinterlegt\n' "$sitz" "$name"
    return 0
  fi
  antwort=$("$CURL_BIN" -sS -m 5 -H "Authorization: $key" -H "Accept-Language: en-US,en" ${SCOPE_ARGS[@]+"${SCOPE_ARGS[@]}"} "$MONITOR_URL" 2>&1) \
    || { printf '%s\t%s\tunlesbar: %s\n' "$sitz" "$name" "$(printf '%s' "$antwort" | head -c 120)"; return 0; }
  stand=$(printf '%s' "$antwort" | python3 -c '
import json, sys
try:
    d = json.load(sys.stdin)
except Exception:
    print("unlesbar: keine JSON-Antwort"); raise SystemExit
if isinstance(d, dict) and d.get("success") is False:
    print("unlesbar: " + str(d.get("msg", d))[:120]); raise SystemExit
if isinstance(d, dict) and d.get("success") is True and not d.get("data"):
    print("Team-Plan aktiv (type=2 success), Monitor liefert noch keine Zahlen"); raise SystemExit
# Bekannte Form (gemessen 26.08., mit Team-Scope-Headern): data.limits[] mit
# unit=3 (5h-Fenster) und unit=6 (Wochenfenster), Werte currentValue/usage/
# percentage/nextResetTime. Diese Form wird als klare c5/cw-Tokens gedruckt;
# jede andere Form faellt auf den generischen Zahlen-Dump zurueck.
limits = (d.get("data") or {}).get("limits") if isinstance(d, dict) else None
if isinstance(limits, list) and limits:
    fenster = {3: "c5", 6: "cw"}
    teile = []
    for l in limits:
        name = fenster.get(l.get("unit"))
        if not name or not isinstance(l.get("percentage"), (int, float)):
            continue
        teile.append(f"{name}=" + str(l["percentage"]))
        for feld, kurz in (("currentValue", "wert"), ("usage", "limit"), ("nextResetTime", "reset")):
            if isinstance(l.get(feld), (int, float)):
                teile.append(f"{name}_{kurz}={l[feld]}")
    if teile:
        print("; ".join(teile)); raise SystemExit
def zahlen(o, pfad=""):
    if isinstance(o, dict):
        for k, v in o.items():
            yield from zahlen(v, f"{pfad}.{k}" if pfad else k)
    elif isinstance(o, list):
        for i, v in enumerate(o):
            yield from zahlen(v, f"{pfad}[{i}]")
    elif isinstance(o, (int, float)):
        yield f"{pfad}={o}"
werte = list(zahlen(d))
print("; ".join(werte)[:300] if werte else "unlesbar: keine Zahlen in der Antwort")
' 2>/dev/null) || stand='unlesbar: Parser-Fehler'
  printf '%s\t%s\t%s\n' "$sitz" "$name" "$stand"
}

while IFS= read -r name; do
  zeile "team-${name##*_}" "$name"
done < <(sed -n 's/^\(ZAI_TEAM_KEY_[0-9]\+\)=.*/\1/p' "$ENV_FILE" | sort -t_ -k4 -n)
# Pack: der Monitor rechnet nach NUTZER+Scope - quota/limit zeigte fuer den
# Pack-Key nur die Sitz-Quota seines Inhabers. Das ECHTE Pack-Guthaben liefert
# /api/biz/tokenAccounts/list/my (Fund 26.08., Konsolen-Bundle billing-Seite):
# tokenBalance/tokensMagnitude je Ressourcenpaket, Ablaufdatum, suitableModel.
# ACHTUNG: das 100M-Pack gilt laut Antwort nur fuer glm-5.3-Inferenz.
pack_zeile() {
  local key antwort
  key=$(sed -n 's/^ZAI_API_KEY=//p' "$ENV_FILE" | head -n 1)
  [ -n "$key" ] || return 0
  antwort=$("$CURL_BIN" -sS -m 5 -H "Authorization: Bearer $key" -H "Accept-Language: en-US,en" \
    "https://api.z.ai/api/biz/tokenAccounts/list/my" 2>&1) \
    || { printf 'pack\tZAI_API_KEY\tunlesbar: %s\n' "$(printf '%s' "$antwort" | head -c 120)"; return 0; }
  printf '%s' "$antwort" | python3 -c '
import json, sys
try:
    d = json.load(sys.stdin)
except Exception:
    print("pack\tZAI_API_KEY\tunlesbar: keine JSON-Antwort"); raise SystemExit
rows = d.get("rows") or []
if d.get("code") != 200 or not rows:
    print("pack\tZAI_API_KEY\tunlesbar: " + str(d.get("msg", "keine Pakete"))[:120]); raise SystemExit
staende = []
for r in rows:
    if r.get("status") != "EFFECTIVE":
        continue
    frei = r.get("availableBalance", 0); ganz = r.get("tokensMagnitude", 0) or 1
    pct = 100.0 * (ganz - frei) / ganz
    ablauf = str(r.get("expirationTime", ""))[:10]
    modell = str(r.get("suitableModel", "?"))
    staende.append(f"pack_frei={frei}; pack_limit={ganz}; pack_verbraucht_pct={pct:.1f}; "
                   f"pack_ablauf={ablauf}; pack_modell={modell}")
print("pack\tZAI_API_KEY\t" + ("; ".join(staende) if staende else "kein wirksames Paket"))
'
}
pack_zeile
exit 0
